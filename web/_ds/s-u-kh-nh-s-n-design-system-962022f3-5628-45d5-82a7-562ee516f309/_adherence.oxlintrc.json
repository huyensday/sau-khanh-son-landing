{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/marketing/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Be Vietnam Pro|Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Be Vietnam Pro, Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|uppercase|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, uppercase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|green|frost|solidGold|solidGreen)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'green' | 'frost' | 'solidGold' | 'solidGreen'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|pulse|disabled|iconLeft|iconRight|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, pulse, disabled, iconLeft, iconRight, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|green|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'green' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:big|md|sm)$/]",
        "message": "<Button> size must be one of 'big' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|edge|radius|pad|glow|hoverLift|frost|as|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: children, edge, radius, pad, glow, hoverLift, frost, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:neutral|green|gold|none)$/]",
        "message": "<GlassCard> edge must be one of 'neutral' | 'green' | 'gold' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|underline|style|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: children, tone, underline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|green|frost)$/]",
        "message": "<Highlight> tone must be one of 'gold' | 'green' | 'frost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|name|multiline|rows|readOnly|required|hint|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, name, multiline, rows, readOnly, required, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|tel|email)$/]",
        "message": "<Input> type must be one of 'text' | 'tel' | 'email'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|children|onClose|width|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, subtitle, children, onClose, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionGroupOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|flag|key|ref|className|style|children)$/]",
        "message": "<OptionGroupOption> doesn't accept that prop. Declared props: value, label, flag."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderFormValues'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|name|phone|address|note|key|ref|className|style|children)$/]",
        "message": "<OrderFormValues> doesn't accept that prop. Declared props: product, name, phone, address, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='PainPointCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|style|key|ref|className|style|children)$/]",
        "message": "<PainPointCard> doesn't accept that prop. Declared props: icon, title, body, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|icon|title|body|style|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: index, icon, title, body, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<ProductSpec> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='USPItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|tone|style|key|ref|className|style|children)$/]",
        "message": "<USPItem> doesn't accept that prop. Declared props: icon, title, body, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='USPItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|gold|frost)$/]",
        "message": "<USPItem> tone must be one of 'green' | 'gold' | 'frost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WarrantyNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|title|points|footnote|style|key|ref|className|style|children)$/]",
        "message": "<WarrantyNotice> doesn't accept that prop. Declared props: badge, title, points, footnote, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
